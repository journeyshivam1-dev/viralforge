# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Omniroute (local)
OMNIROUTE_BASE_URL=http://localhost:20128
OMNIROUTE_API_KEY=your-omniroute-api-key
OMNIROUTE_TIMEOUT_MS=300000
OMNIROUTE_WEBHOOK_SECRET=your-omniroute-webhook-secret

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# S3/Minio
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=viralforge-content
S3_REGION=us-east-1

# Content Generation
CONTENT_GENERATION_PROVIDER=omniroute
ENABLE_S3_STORAGE=true

# Publishing Safety
PUBLISHING_DISABLED=true

# Feature Flags
ENABLE_TELEGRAM=true
ENABLE_WHATSAPP=true
ENABLE_CALENDAR=true
ENABLE_METRICS=true

# Supported Niches
SUPPORTED_NICHES=food,health,tech,edtech,travel,cartoon
DEFAULT_NICHE=food

# Limits
MAX_POSTS_PER_DAY_PER_ACCOUNT=5
MAX_JOBS_PER_HOUR_PER_ORG=50
PUBLISHING_RETRY_MAX=3

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# API Server
PORT=3000
NODE_ENV=development
API_URL=http://localhost:3000

# Database
POSTGRES_USER=viralforge
POSTGRES_PASSWORD=viralforge
POSTGRES_DB=viralforge
