# Local Supabase CLI (copy keys from: npm run supabase:status)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# AI provider chain: Omniroute first, then Gemini, then Replicate (images) if set.
# Omniroute (OpenAI-compatible gateway on your LAN)
OMNIROUTE_BASE_URL=http://192.168.31.13:20128
OMNIROUTE_API_KEY=replace-with-omniroute-api-key
OMNIROUTE_TEXT_MODEL=auto/best-chat
OMNIROUTE_TIMEOUT_MS=300000
# Leave a model empty to skip Omniroute for that capability (falls back to Gemini).
OMNIROUTE_IMAGE_MODEL=
OMNIROUTE_IMAGE_TIMEOUT_MS=180000
OMNIROUTE_TTS_MODEL=
OMNIROUTE_TTS_VOICE=
OMNIROUTE_TTS_TIMEOUT_MS=120000
# Video is optional (reels are image slideshows by default). Submission is quick;
# the result is polled at {OMNIROUTE_VIDEO_PATH}/{id} until the timeout.
OMNIROUTE_VIDEO_MODEL=
OMNIROUTE_VIDEO_PATH=
OMNIROUTE_VIDEO_TIMEOUT_MS=600000
OMNIROUTE_WEBHOOK_SECRET=replace-with-omniroute-webhook-secret

# Gemini fallback (Google AI Studio key). Sent as a header, never in URLs.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# Prebuilt voice; Kore / Puck / Charon all speak Hindi.
GEMINI_TTS_VOICE=Kore
GEMINI_TIMEOUT_MS=180000
TTS_LANGUAGE=hi-IN

# Trends for daily topic ideation. Google Trends RSS needs no key.
YOUTUBE_API_KEY=

# Replicate media generation. Keep real tokens only in .env or your secret manager.
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL_VERSION=
# Optional: configure to enable video generation.
REPLICATE_VIDEO_MODEL_VERSION=
REPLICATE_TIMEOUT_MS=120000
MEDIA_MAX_CONCURRENT_SCENES=2
MEDIA_DOWNLOAD_MAX_BYTES=52428800
# Reels carry Hindi TTS voiceover; set true only to accept silent reels.
ALLOW_SILENT_VIDEO=false

# Pipeline and scheduling
PIPELINE_STAGE_LEASE_SECONDS=900
OUTBOX_DISPATCH_BATCH_SIZE=25
SCHEDULE_LOOKAHEAD_MINUTES=15
TEMP_DIR=./tmp/viralforge

# API server
PORT=3000
NODE_ENV=development
API_URL=http://localhost:3000

# Publishing safety. Keep true for local development: local signed URLs are not
# reachable by Meta's servers.
PUBLISHING_DISABLED=true

# Public media edge (only this port is exposed through a tunnel for Meta to fetch media).
MEDIA_EDGE_PORT=3100
# https URL of the tunnel pointing at MEDIA_EDGE_PORT, e.g. https://xyz.trycloudflare.com
PUBLIC_MEDIA_BASE_URL=
# >= 32 random chars: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MEDIA_URL_SIGNING_SECRET=

# AES-256-GCM key for Meta access tokens at rest (32 bytes, base64):
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
META_GRAPH_VERSION=v23.0

# Meta OAuth and publishing
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:3000/api/accounts/meta/callback
META_LOGIN_CONFIG_ID=
META_ALLOW_LEGACY_META_SCOPES=false

# Telegram bot: approvals, commands and alerts.
# polling (default, nothing exposed) | webhook (hosted; needs TELEGRAM_WEBHOOK_SECRET)
TELEGRAM_MODE=polling
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user ids allowed to approve/command. Empty = nobody (fail closed).
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_WEBHOOK_SECRET=
# Chat IDs (comma-separated) that receive failure alerts and approval requests.
TELEGRAM_ALERT_CHAT_IDS=

# WhatsApp trigger
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_URL=
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ALLOWED_PHONES=
# Alert recipients in E.164 without '+', comma-separated. Free-form text only
# delivers inside the 24h customer-service window; set an approved template for
# reliable alerts.
WHATSAPP_ALERT_TO=
WHATSAPP_ALERT_TEMPLATE=
WHATSAPP_ALERT_TEMPLATE_LANGUAGE=en

# Dashboard base URL used in alert links
DASHBOARD_URL=http://localhost:3001

# Limits
MAX_POSTS_PER_DAY_PER_ACCOUNT=5
MAX_JOBS_PER_HOUR_PER_ORG=50
PUBLISHING_RETRY_MAX=3
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000
