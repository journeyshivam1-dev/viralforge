# Local Supabase CLI (copy keys from: npm run supabase:status)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Omniroute (local)
OMNIROUTE_BASE_URL=http://localhost:20128
OMNIROUTE_API_KEY=replace-with-omniroute-api-key
OMNIROUTE_TEXT_MODEL=auto/best-chat
OMNIROUTE_TIMEOUT_MS=300000
OMNIROUTE_WEBHOOK_SECRET=replace-with-omniroute-webhook-secret

# Replicate media generation. Keep real tokens only in .env or your secret manager.
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL_VERSION=
# Optional: configure to enable video generation.
REPLICATE_VIDEO_MODEL_VERSION=
REPLICATE_TIMEOUT_MS=120000
MEDIA_MAX_CONCURRENT_SCENES=2
MEDIA_DOWNLOAD_MAX_BYTES=52428800
# Scene-image reels are valid without TTS; validation records an audio warning.
ALLOW_SILENT_VIDEO=true

# Pipeline and scheduling
PIPELINE_STAGE_LEASE_SECONDS=900
OUTBOX_DISPATCH_BATCH_SIZE=25
SCHEDULE_LOOKAHEAD_MINUTES=15
TEMP_DIR=./tmp/viralforge

# API server
PORT=3000
NODE_ENV=development
API_URL=http://localhost:3000

# Publishing safety. Keep true for local development: local signed URLs are not
# reachable by Meta's servers.
PUBLISHING_DISABLED=true

# Meta OAuth and publishing
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:3000/api/accounts/meta/callback
META_LOGIN_CONFIG_ID=
META_ALLOW_LEGACY_META_SCOPES=false

# Telegram trigger
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# WhatsApp trigger
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_URL=
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ALLOWED_PHONES=

# Limits
MAX_POSTS_PER_DAY_PER_ACCOUNT=5
MAX_JOBS_PER_HOUR_PER_ORG=50
PUBLISHING_RETRY_MAX=3
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000
