# ViralForge Environment Configuration
# Copy this file to .env and fill in your actual values

# Environment
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Supabase (PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis (for BullMQ)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Storage (S3-compatible)
# Local: Minio (Docker Compose)
# Cloud: AWS S3, Google Cloud Storage, etc.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=viralforge-content
S3_REGION=us-east-1

# Omniroute (Local Content Generation)
# Your locally installed Omniroute handles image, video, and text generation
OMNIROUTE_BASE_URL=http://localhost:3001
OMNIROUTE_API_KEY=your-omniroute-api-key
OMNIROUTE_WEBHOOK_SECRET=your-omniroute-webhook-secret
OMNIROUTE_TIMEOUT_MS=300000

# Content Generation (Omniroute-based)
# No direct Gemini API keys needed - Omniroute handles generation
CONTENT_GENERATION_PROVIDER=omniroute

# Social Media APIs
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_ACCESS_TOKEN=your-meta-access-token

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/webhooks/telegram

# WhatsApp Business
WHATSAPP_PHONE_ID=your-whatsapp-phone-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_VERIFY_TOKEN=your-whatsapp-verify-token
WHATSAPP_WEBHOOK_URL=https://your-domain.com/api/webhooks/whatsapp

# Music Library
MUSIC_LIBRARY_PATH=./packages/templates/music
MUSIC_LICENSE_TRACKER=enabled

# Google Cloud TTS (for Hindi voiceover)
GOOGLE_APPLICATION_CREDENTIALS=./google-cloud-credentials.json

# Optional AI Media Generation (fallback)
REPLICATE_API_TOKEN=your-replicate-token
ELEVENLABS_API_KEY=your-elevenlabs-key

# Stripe (deferred to later)
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Security
ENCRYPTION_KEY=your-base64-encoded-32-byte-key
JWT_SECRET=your-jwt-secret
SESSION_SECRET=your-session-secret

# Feature Flags
PUBLISHING_DISABLED=false
ENABLE_TELEGRAM=true
ENABLE_WHATSAPP=true
ENABLE_CALENDAR=true
ENABLE_S3_STORAGE=true
ENABLE_METRICS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Niche Configuration
DEFAULT_NICHE=food
SUPPORTED_NICHES=food,health,tech,edtech,travel,cartoon

# Publishing Limits
MAX_POSTS_PER_DAY_PER_ACCOUNT=5
MAX_JOBS_PER_HOUR_PER_ORG=50
PUBLISHING_RETRY_MAX=3