FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY services/api/package.json ./services/api/package.json
COPY services/workers/package.json ./services/workers/package.json
COPY services/dashboard/package.json ./services/dashboard/package.json
COPY packages/domain/package.json ./packages/domain/package.json
COPY packages/supabase/package.json ./packages/supabase/package.json

RUN npm ci

COPY tsconfig.json ./tsconfig.json
COPY packages/domain/ ./packages/domain/
COPY packages/supabase/ ./packages/supabase/
COPY services/api/ ./services/api/

RUN npm run build --workspace=packages/domain \
  && npm run build --workspace=packages/supabase \
  && npm run build --workspace=services/api \
  && npm prune --omit=dev

FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production

COPY --from=builder /app/package.json /app/package-lock.json ./
COPY --from=builder /app/node_modules/ ./node_modules/
COPY --from=builder /app/packages/domain/package.json ./packages/domain/package.json
COPY --from=builder /app/packages/domain/dist/ ./packages/domain/dist/
COPY --from=builder /app/packages/supabase/package.json ./packages/supabase/package.json
COPY --from=builder /app/packages/supabase/dist/ ./packages/supabase/dist/
COPY --from=builder /app/services/api/package.json ./services/api/package.json
COPY --from=builder /app/services/api/dist/ ./services/api/dist/

RUN addgroup -S appgroup && adduser -S appuser -G appgroup \
  && chown -R appuser:appgroup /app
USER appuser

EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -q -T 2 -O /dev/null http://127.0.0.1:3000/health || exit 1

CMD ["node", "services/api/dist/main.js"]
