FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY services/api/package.json ./services/api/package.json
COPY services/workers/package.json ./services/workers/package.json
COPY services/dashboard/package.json ./services/dashboard/package.json
COPY packages/domain/package.json ./packages/domain/package.json
COPY packages/supabase/package.json ./packages/supabase/package.json

RUN npm ci

COPY tsconfig.json ./tsconfig.json
COPY packages/domain/ ./packages/domain/
COPY packages/supabase/ ./packages/supabase/
COPY services/workers/ ./services/workers/

RUN npm run build --workspace=packages/domain \
  && npm run build --workspace=packages/supabase \
  && npm run build --workspace=services/workers \
  && npm prune --omit=dev

FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production

RUN apk add --no-cache ffmpeg fontconfig font-noto font-noto-devanagari

COPY --from=builder /app/package.json /app/package-lock.json ./
COPY --from=builder /app/node_modules/ ./node_modules/
COPY --from=builder /app/packages/domain/package.json ./packages/domain/package.json
COPY --from=builder /app/packages/domain/dist/ ./packages/domain/dist/
COPY --from=builder /app/packages/supabase/package.json ./packages/supabase/package.json
COPY --from=builder /app/packages/supabase/dist/ ./packages/supabase/dist/
COPY --from=builder /app/services/workers/package.json ./services/workers/package.json
COPY --from=builder /app/services/workers/dist/ ./services/workers/dist/

RUN addgroup -S appgroup && adduser -S appuser -G appgroup \
  && mkdir -p /tmp/viralforge \
  && chown -R appuser:appgroup /app /tmp/viralforge
USER appuser

CMD ["node", "services/workers/dist/index.js"]
